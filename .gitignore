node_modules/
dist/
out/
.DS_Store
*.log
.env
.env.*

# ----- iOS / Capacitor -----
# Pods is reproduced by `pod install` from Podfile.lock — committing it
# would bloat the repo with hundreds of dependencies.
ios/App/Pods/
# public/ is generated by `npm run cap:sync` from src/ and would
# duplicate every JS / CSS change in two places.
ios/App/App/public/
# capacitor-cordova-ios-plugins is regenerated by `npx cap sync`.
ios/capacitor-cordova-ios-plugins/
# Xcode build artefacts
ios/App/build/
ios/App/DerivedData/
ios/App/*.xcuserstate
ios/App/*.xcworkspace/xcuserdata/
ios/App/App.xcodeproj/xcuserdata/
ios/App/App.xcodeproj/project.xcworkspace/xcuserdata/
